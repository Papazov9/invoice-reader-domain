# Copy to .env on the server (NEVER commit the real values).

# --- Invoice reader ---------------------------------------------------------
# Shared secret guarding the extraction endpoints.
# Same value must also be set as the INGEST_SERVICE_TOKEN secret in Supabase.
INGEST_SERVICE_TOKEN=

# Anthropic API key for the Claude Haiku 4.5 vision safety net (hard photos only).
# Digital PDFs are read deterministically and never call Claude.
ANTHROPIC_API_KEY=

# --- Primex FTP front door (SFTPGo + feed-bridge) ---------------------------
# The VPS public IPv4 that SFTPGo advertises to FTP clients for passive mode.
VPS_PUBLIC_IP=

# Production Supabase project the feed imports into (gumialex live project).
SUPABASE_URL=https://nuhhxicnqfxbgedlowjk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret guarding primex-feed-import. Must equal the PRIMEX_IMPORT_SECRET
# secret set in that Supabase project.
PRIMEX_IMPORT_SECRET=
