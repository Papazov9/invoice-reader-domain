# Copy to .env on the server (NEVER commit the real values).

# Shared secret guarding the extraction endpoints.
# Same value must also be set as the INGEST_SERVICE_TOKEN secret in Supabase.
INGEST_SERVICE_TOKEN=

# Anthropic API key for the Claude Haiku 4.5 vision safety net (hard photos only).
# Digital PDFs are read deterministically and never call Claude.
ANTHROPIC_API_KEY=
